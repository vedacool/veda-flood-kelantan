# Copy to .env and fill in. Never commit .env.
# --- Run mode ---
SAMPLE_MODE=false            # true = offline judge mode, no keys needed
# --- Meterless Nightshift (only AI provider) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL_FAST=meterless/fast
METERLESS_MODEL_DEEP=meterless/deep
METERLESS_APP_FAST=veda-fast     # meterless-app header per lane (Nightshift pins mode per app)
METERLESS_APP_DEEP=veda-deep
METERLESS_EXPECT_FAST=          # optional: model that must answer lane fast (default Nemotron 3.5 Lightning)
METERLESS_EXPECT_DEEP=          # optional: model that must answer lane deep (default Nemotron 3.5 Super VL)
# --- Zetaris (local Docker) ---
ZETARIS_API_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
# --- Optional ---
VEDA_FAULTS=                 # e.g. jps_timeout,stale_api (testing only, logged)
# --- VEDA Postgres (veda-pg container, host port 5433) ---
VEDA_PG_PASSWORD=             # postgres superuser (Python writes)
VEDA_PG_RO_PASSWORD=          # read-only role veda_zetaris (Zetaris reads)
